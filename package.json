{
  "name": "kawsay",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "prepare": "husky",
    "evals": "pnpm --filter @kawsay/core --filter @kawsay/contracts build && pnpm --filter @kawsay/api build && node apps/api/dist/evals/run-evals.js"
  },
  "prettier": "@kawsay/config/prettier",
  "devDependencies": {
    "@kawsay/config": "workspace:*",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
