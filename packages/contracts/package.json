{
  "name": "@kawsay/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas for every API request and response and every synced record (ADR 0018)",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kawsay/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
